# 复制成 backend/.env 后填写即可，run.py 会自动读取。
# 真正的环境变量优先级高于这个文件。

# ---- 模型接口（不填就完全关闭 LLM 相关功能）----
# 任何 OpenAI 兼容接口都可以，下面是几个常见的 base_url：
#   OpenAI     https://api.openai.com/v1
#   DeepSeek   https://api.deepseek.com/v1
#   Moonshot   https://api.moonshot.cn/v1
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
SYSCHOICE_LLM_API_KEY=
SYSCHOICE_LLM_BASE_URL=https://api.openai.com/v1
SYSCHOICE_LLM_MODEL=gpt-4o-mini

# ---- 其它 ----
# 后台管理令牌（默认 syschoice-admin，公开部署时务必修改）
# SYSCHOICE_ADMIN_TOKEN=
# IP 哈希加盐，公开部署时务必修改
# SYSCHOICE_SECRET=
# 数据库位置
# SYSCHOICE_DB=./data/app.db
# 监听地址，:: 为 IPv4/IPv6 双栈
# SYSCHOICE_HOST=::
